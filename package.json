{
  "name": "cyrano",
  "version": "1.0.0",
  "description": "Cross-Platform Invisibility-First Teleprompter & AI Meeting Copilot",
  "author": "Cyrano Team <support@cyrano.app>",
  "homepage": "https://cyrano.app",
  "desktopName": "cyrano.desktop",
  "private": true,
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "npm run build:renderer && npm run build:main && npm run build:preload",
    "build:renderer": "vite build",
    "build:main": "esbuild src/main/index.ts --bundle --platform=node --target=node20 --external:electron --external:@huggingface/transformers --external:onnxruntime-node --external:sharp --outfile=dist/main/index.js",
    "build:preload": "esbuild src/preload/index.ts --bundle --platform=node --target=node20 --external:electron --outfile=dist/preload/index.js",
    "start": "electron .",
    "package": "npm run build && electron-builder --dir",
    "dist:mac": "npm run build && electron-builder --mac dmg",
    "build:dmg": "npm run build && electron-builder --mac dmg",
    "dist:win": "npm run build && electron-builder --win --x64 && npm run verify:package -- release/win-unpacked",
    "build:win": "npm run build && electron-builder --win --x64 && npm run verify:package -- release/win-unpacked",
    "dist:linux": "npm run build && electron-builder --linux --x64",
    "build:linux": "npm run build && electron-builder --linux --x64",
    "dist:all": "npm run build && electron-builder --mac --win --linux --x64 && npm run verify:package -- release/win-unpacked",
    "download:model": "node scripts/download-whisper-model.js",
    "verify:package": "node scripts/verify-package.js",
    "test": "vitest run --root .",
    "typecheck": "tsc --noEmit"
  },
  "build": {
    "appId": "com.cyrano.teleprompter",
    "productName": "Cyrano",
    "extraResources": [
      {
        "from": "resources/whisper-models",
        "to": "whisper-models",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "node_modules/audiotee/bin/audiotee",
        "to": "audiotee"
      }
    ],
    "asarUnpack": [
      "**/node_modules/onnxruntime-node/**/*",
      "**/node_modules/@huggingface/**/*",
      "**/node_modules/@img/**/*",
      "**/node_modules/sharp/**/*"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Cyrano requires microphone access to transcribe your speech in AI Meeting Copilot mode.",
        "NSAudioCaptureUsageDescription": "Cyrano requires system audio capture to listen to meeting questions in AI Meeting Copilot mode."
      }
    },
    "dmg": {
      "title": "${productName} ${version}",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Cyrano"
    },
    "portable": {
      "artifactName": "${productName}-${version}-Portable.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Utility",
      "maintainer": "Cyrano Team <support@cyrano.app>",
      "synopsis": "Stealth Teleprompter & Real-Time AI Meeting Copilot",
      "syncDesktopName": true,
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "build/icon.ico",
      "build/icon.png",
      "package.json"
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@huggingface/transformers": "4.3.2",
    "audiotee": "0.0.7",
    "lucide-react": "^1.16.0",
    "onnxruntime-node": "1.30.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "10.4.21",
    "electron": "^45.3.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.24.0",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.17",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "2.1.9"
  }
}
