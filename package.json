{
  "name": "cyrano",
  "version": "1.0.0",
  "description": "macOS Invisibility-First Teleprompter Desktop Application",
  "private": true,
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "npm run build:renderer && npm run build:main && npm run build:preload",
    "build:renderer": "vite build",
    "build:main": "esbuild src/main/index.ts --bundle --platform=node --target=node20 --external:electron --outfile=dist/main/index.js",
    "build:preload": "esbuild src/preload/index.ts --bundle --platform=node --target=node20 --external:electron --outfile=dist/preload/index.js",
    "start": "electron .",
    "package": "npm run build && electron-builder --dir",
    "dist:mac": "npm run build && electron-builder --mac dmg",
    "build:dmg": "npm run build && electron-builder --mac dmg",
    "typecheck": "tsc --noEmit"
  },
  "build": {
    "appId": "com.cyrano.teleprompter",
    "productName": "Cyrano",
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "${productName} ${version}",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ]
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
